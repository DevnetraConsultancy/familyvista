# Copy to .env.local (local) and set the same keys in Vercel → Project → Settings → Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Public site address, used for social previews (Open Graph). Optional on Vercel.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
